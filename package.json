{
  "name": "mlb-shoes-dashboard-public",
  "private": true,
  "type": "module",
  "scripts": {
    "daily": "node scripts/publish-curated.mjs --maintenance",
    "weekly": "node scripts/weekly-update.mjs",
    "monthly": "python scripts/monthly/update.py",
    "curate": "node scripts/publish-curated.mjs",
    "keywords": "node scripts/refresh-keywords.mjs",
    "photos": "node scripts/cache-product-photos.mjs",
    "prices": "node scripts/collect-prices.mjs",
    "colors": "python scripts/photo_body_colors.py",
    "audit": "node scripts/audit-duplicates.mjs",
    "categories": "node scripts/build-model-categories.mjs",
    "briefing": "node scripts/weekly-briefing.mjs",
    "archive": "node scripts/archive-expired.mjs",
    "build": "node scripts/sync-site-brands.mjs && node scripts/validate_catalog.mjs && node scripts/build.mjs",
    "build:redirect": "node scripts/build-legacy-redirect.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui-browser.mjs",
    "ranks": "node scripts/collect-rank-boards.mjs",
    "wgsn": "node scripts/import-wgsn-runway.mjs",
    "catwalk": "python scripts/build_catwalk.py",
    "internal": "node scripts/deploy-internal.mjs",
    "catwalk:library": "python scripts/build_catwalk_library.py",
    "deploy": "node scripts/deploy-internal.mjs",
    "internal:set-password": "node scripts/set-internal-password.mjs",
    "catwalk:collect": "node scripts/collect-catwalk-season.mjs",
    "catwalk:compose": "node scripts/build-catwalk-snapshot.mjs",
    "catwalk:login": "node scripts/wgsn-login.mjs",
    "catwalk:update": "node scripts/update-catwalk.mjs",
    "curation": "node scripts/build-curation-summary.mjs",
    "verify": "node scripts/weekly-update.mjs --verify-only",
    "guide": "python -X utf8 scripts/build-user-guide.py && node scripts/render-user-guide.mjs",
    "sports:collect": "node scripts/collect-sports-casual.mjs",
    "sports:prepare": "node scripts/prepare-sports-casual.mjs && node scripts/download-scoped-photos.mjs && python -X utf8 scripts/cache-sports-casual-photos.py reports/sports-casual-prepared.json reports/sports-casual-cached.json",
    "sports:publish": "node scripts/publish-sports-casual.mjs --prepared reports/sports-casual-cached.json --raw data/sports-casual-new.json,data/fila-china-new.json,data/official-new-feeds.json,data/puma-korea-new.json,data/rendered-official-new.json,data/asics-complete-new.json,data/ash-complete-new.json,data/adidas-complete-new.json,data/newbalance-complete-new.json,data/converse-complete-new.json,data/scoped-photo-repairs.json,data/columbia-new.json,data/dkon-new.json"
  },
  "dependencies": {
    "playwright": "^1.55.0"
  }
}
